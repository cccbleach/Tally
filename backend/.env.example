# 服务端口与监听地址
PORT=8080
HOST=0.0.0.0

# SQLite 数据库文件路径（相对 backend 目录）
DATABASE_URL=./data/tally.db

# JWT 签名密钥：生产环境务必改为随机长字符串
JWT_SECRET=change-me-to-a-long-random-secret

# 业务时区（决定“今天/当月”口径），默认 Asia/Shanghai
# APP_TIMEZONE=Asia/Shanghai

# 基准币种（统计/总资产换算的统一口径），默认 CNY
# BASE_CURRENCY=CNY

# CORS 白名单（逗号分隔）。为空则开发期放行所有；生产建议显式列出前端域名
# CORS_ORIGINS=https://app.example.com

# JWT 有效期：访问令牌短、刷新令牌长
# ACCESS_TOKEN_TTL=15m
# REFRESH_TOKEN_TTL=30d
