# 运行环境：production 会启用更严格的安全校验（强 JWT_SECRET、CORS 不默认放行、验证码/重置 token 不回传等）
# NODE_ENV=production

# 服务端口与监听地址
PORT=8080
HOST=0.0.0.0

# SQLite 数据库文件路径（相对 backend 目录）
DATABASE_URL=./data/tally.db

# JWT 签名密钥：
# - 生产环境必须设置为 ≥32 位的强随机字符串，且不能是示例/占位值，否则拒绝启动
# - 生成方式：openssl rand -hex 32
# 下面的值是“本地开发占位”，生产部署务必替换
JWT_SECRET=dev-local-only-not-for-production

# 业务时区（决定“今天/当月”口径），默认 Asia/Shanghai
# APP_TIMEZONE=Asia/Shanghai

# 基准币种（统计/总资产换算的统一口径），默认 CNY
# BASE_CURRENCY=CNY

# CORS 白名单（逗号分隔）。
# - 开发环境为空则放行所有
# - 生产环境为空则【不】放行任意 Origin（只允许无 Origin 的同源请求），因此生产务必显式列出前端域名
# CORS_ORIGINS=https://app.example.com

# 可信反向代理层数：仅当部署在 Caddy/Nginx 之后时才设置（用于从 X-Forwarded-For 取真实客户端 IP）。
# 默认 0 = 不信任客户端提交的 X-Forwarded-For，防止伪造 IP 绕过限流。
# 配置 N>0 时，取 XFF 中“从右往左第 N 个”地址（最左侧可能是客户端伪造），例如 TRUST_PROXY=1 取最右侧。
# TRUST_PROXY=1

# 关闭认证接口限流（不建议生产使用；测试或内网联调可临时开启）
# DISABLE_RATE_LIMIT=true

# 认证模式：production 下验证码/重置 token 永不回传；开发模式才允许回传便于联调
# AUTH_MODE=development

# JWT 有效期：访问令牌短、刷新令牌长
# ACCESS_TOKEN_TTL=15m
# REFRESH_TOKEN_TTL=30d

# 阿里云短信（验证码登录 + 找回密码）
# 生产【必须】配置：登录验证码与 /api/v1/auth/reset-code 都靠短信投递；
# 未配置时生产环境这两个接口会返回 503（刻意不返回“成功但用户拿不到验证码”）。
# 不配置则进入“开发模式”，验证码直接返回给客户端（仅 AUTH_MODE=development 时）。
# ALIYUN_SMS_ENABLED=true
# ALIYUN_ACCESS_KEY_ID=your-access-key-id
# ALIYUN_ACCESS_KEY_SECRET=your-access-key-secret
# ALIYUN_SMS_SIGN_NAME=你的签名
# ALIYUN_SMS_TEMPLATE_CODE=100001
# ALIYUN_SMS_SCHEME_NAME=Tally
# ALIYUN_SMS_COUNTRY_CODE=86

# ------------------------------------------------------------------
# 账号恢复（重要）：本项目只支持「短信验证码 → 直接设置新密码」
#   POST /api/v1/auth/reset-code     {account: 手机号}
#   POST /api/v1/auth/reset-password {account, code, newPassword}
# 未接入 SMTP，也没有任何邮件投递：旧的 POST /auth/forgot-password（邮件 reset token）
# 已从后端路由 / OpenAPI / iOS 三处下线，不要再实现或调用它。
# 邮箱账号无自助找回通道，需管理员人工核实后重置（见 docs/production-checklist.md）。
# ------------------------------------------------------------------

# 日志级别：生产建议 info（Fastify pino JSON）；off 关闭访问日志
# LOG_LEVEL=info

# 生产/预发域名约定（见 docs/production-checklist.md）：
#   生产  https://api.tallyapp.cn          ← TALLY_DOMAIN（Caddy 签发证书）/ CORS_ORIGINS
#   预发  https://staging-api.tallyapp.cn  ← CI Release 构建注入的 TALLY_API_BASE_URL
# 禁止 localhost / 127.0.0.1 / example.com / your-* 等占位地址进入 Release 产物
# （由 ios/scripts/validate-api-url.sh 在构建期与产物复核两处拦截）。
